{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		// TypeScript maps package.json "imports" without trying extensions, so
		// #lib needs a paths entry too; keep the two in step.
		"paths": { "#lib/*": ["./src/lib/*"] },
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts", "playwright.config.ts", "tests"]
}
