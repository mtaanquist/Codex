{
	"name": "codex",
	"private": true,
	"version": "3.20.0",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"worker": "node --import ./src/worker/register.js src/worker/index.ts",
		"dev:prod-copy": "DATABASE_URL=postgres://codex:codex@localhost:5432/codex_prod_copy vite dev",
		"worker:prod-copy": "DATABASE_URL=postgres://codex:codex@localhost:5432/codex_prod_copy npm run worker",
		"restore:prod-copy": "node scripts/restore-prod-copy.ts",
		"migrate": "node scripts/migrate.ts",
		"seed:admin": "node scripts/seed-admin.ts",
		"backup": "node scripts/run-backup.ts",
		"restore:backup": "node scripts/restore-backup.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/spectral": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/turndown": "^5.0.6",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/lib-storage": "^3.1152.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.14",
		"@node-rs/argon2": "^2.2.2",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"d3-force": "^3.0.0",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"mammoth": "^1.13.0",
		"markdown-it": "^15.0.3",
		"nodemailer": "^10.1.7",
		"pg": "^8.23.1",
		"pg-boss": "^12.38.0",
		"puppeteer-core": "^25.14.0",
		"qrcode": "^1.5.4",
		"turndown": "^7.2.4"
	}
}
